{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "namedesignai-cloudflare-staging",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "vars": {
    "DB_AUTH_BACKEND": "service",
    "AUTH_EXTERNAL_SYNC_MODE": "noop",
    "DATABASE_URL": "postgresql://invalid:invalid@db.invalid:5432/invalid",
    "NEXTAUTH_URL": "https://namedesignai-cloudflare-staging.hdnstudio.workers.dev",
    "HOST_NAME": "https://namedesignai-cloudflare-staging.hdnstudio.workers.dev",
    "DB_VARIANT_AVAILABILITY_BACKEND": "service",
    "DB_PRODUCT_PRICING_BACKEND": "service",
    "DB_PRINTFUL_VARIANT_CACHE_BACKEND": "service",
    "DB_ORDER_TRACKING_BACKEND": "service"
  },
  "services": [
    {
      "binding": "DB_SERVICE",
      "service": "namedesignai-db-staging"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
