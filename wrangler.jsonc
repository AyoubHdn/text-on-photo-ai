{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "namedesignai-cloudflare-staging",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "vars": {
    "DB_AUTH_BACKEND": "service",
    "DB_USER_READS_BACKEND": "service",
    "DB_ICON_READS_BACKEND": "service",
    "DB_ICON_WRITES_BACKEND": "service",
    "AUTH_EXTERNAL_SYNC_MODE": "noop",
    "GENERATION_LAMBDA_REGION": "us-east-1",
    "GENERATION_LAMBDA_FUNCTION_NAME": "namedesignai-generation-staging",
    "ASYNC_GENERATION_ENABLED": "false",
    "DATABASE_URL": "postgresql://invalid:invalid@db.invalid:5432/invalid",
    "NEXTAUTH_URL": "https://namedesignai-cloudflare-staging.hdnstudio.workers.dev",
    "HOST_NAME": "https://namedesignai-cloudflare-staging.hdnstudio.workers.dev",
  },
  "services": [
    {
      "binding": "DB_SERVICE",
      "service": "namedesignai-db-staging"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
