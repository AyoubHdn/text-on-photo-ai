{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "namedesignai-cloudflare-staging",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "vars": {
    "DB_VARIANT_AVAILABILITY_BACKEND": "service",
    "DB_PRODUCT_PRICING_BACKEND": "service"
  },
  "services": [
    {
      "binding": "DB_SERVICE",
      "service": "namedesignai-db-staging"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
